; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Strongerholder"
config/version="Development"
run/main_scene="uid://bmwhs3lwb74ue"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://helmet.png"

[autoload]

Game="*res://game/game.gd"
EventBus="*res://addons/event_bus_plugin/EventBus.gd"
UserInterface="res://user_interface/user_interface.tscn"
ToastParty="*res://addons/toastparty/toast-autoload.gd"
GameWorld="*res://gameplay/game_world.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/deprecated_keyword=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/event_bus_plugin/plugin.cfg", "res://addons/radial_progress/plugin.cfg", "res://addons/toastparty/plugin.cfg")

[global_group]

PropertiesSerializers="All nodes responsible for serializing persistent property data"
NodeSerializers="All nodes responsible for serializing persistent, dynamically spawned nodes"
IntangibleSerializers="All nodes responsible for serializing persistent, unrealiable property data; e.g. concerning multiplayer"
CharacterControllers=""

