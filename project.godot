[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Characters"
3d_physics/layer_3="Items"
3d_physics/layer_5="WorldAreas"
3d_physics/layer_6="HitBoxes"
3d_physics/layer_7="HurtBoxes"
3d_physics/layer_17="Ghosts"
