; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Strongerholder"
config/version="Development"
run/main_scene="uid://bvt1s3i2xw5s6"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://helmet.png"

[autoload]

Client="*res://client/client.gd"
Multiplayer="*res://client/multiplayer/multiplayer.gd"
Lobby="*res://client/lobby/lobby.gd"
Serializer="*res://client/serialization/serializer.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
ToastParty="*res://addons/toastparty/toast-autoload.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/deprecated_keyword=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/radial_progress/plugin.cfg", "res://addons/toastparty/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "orange",
"res://client/": "gray",
"res://engine/": "blue",
"res://game/": "yellow",
"res://protoype_assets/": "teal",
"res://tools/": "red",
"res://user_interface/": "green"
}

[global_group]

Claymations=""
SerializersNodes="All nodes responsible for serializing persistent, dynamically spawned nodes"
SerializersProperties="All nodes responsible for serializing persistent property data"
Spawners=""
Characters=""
CharacterSpawnPoints=""
PlayerSpawnPoints=""

